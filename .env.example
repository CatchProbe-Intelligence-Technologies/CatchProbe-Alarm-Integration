# ---------------------------------------------------------------------------
# CatchProbe Alarm Integration - configuration
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
# CatchProbe API key (x-api-key header).
CATCHPROBE_API_KEY=your-api-key-here
# CatchProbe organization id (organizationid header).
CATCHPROBE_ORGANIZATION_ID=your-organization-id-here
# Destination webhook that receives each alarm's detail payload.
WEBHOOK_URL=https://webhook.site/your-endpoint-id

# --- Optional ---------------------------------------------------------------
# Base URL of the CatchProbe core API.
CATCHPROBE_BASE_URL=https://core-api.catchprobe.io

# Rules to follow. "*" means every rule (core_rule_id is omitted).
# For specific rules use a comma-separated list, e.g. FOLLOW_RULE_IDS=id1,id2
FOLLOW_RULE_IDS=*

# Status of alarms to process (new alarms arrive as "new").
ALARM_STATUS=new

# Polling interval in seconds (used unless --once is passed).
POLL_INTERVAL_SECONDS=30

# Page size for the paginated alarm list endpoint.
PER_PAGE=20

# Per-request timeout in seconds.
REQUEST_TIMEOUT=30

# Pause between processing two alarms (seconds) to respect rate limits.
DELAY_BETWEEN_ALARMS=1.0

# Retry policy for HTTP 429 (Too Many Requests).
MAX_RETRIES=5
RETRY_BACKOFF_SECONDS=2.0

# Logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
